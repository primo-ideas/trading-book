# CurseForge packaging. Without package-as, the zip's folder would take the project
# slug (trading-book), and the client would not match it to TradingBook.toc.
package-as: TradingBook

# Same content as install.ps1 installs: the .toc and the files it lists.
# Files starting with a dot are always left out.
ignore:
    - tests
    - install.ps1
    - README.md
    - README.fr.md
    - LICENSE
