# CurseForge packaging. Without package-as, the zip's folder would take the project
# slug (trading-book), and the client would not match it to TradingEssentials.toc.
package-as: TradingEssentials

# Same content as install.ps1 installs: the .toc, the files it lists, and Media.
# Files starting with a dot are always left out.
ignore:
    - tests
    - install.ps1
    - README.md
    - docs
    - LICENSE
    - CLAUDE.md
    - art
